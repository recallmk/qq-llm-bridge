/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/gemini.md
!/docs/maintenance.md
!/ds-QQ/
/ds-QQ/AGENTS.md
!/gemini-QQ/
/gemini-QQ/*
!/gemini-QQ/bridge/
/gemini-QQ/bridge/*
!/gemini-QQ/bridge/*.mjs
!/gemini-QQ/bridge/*.html
!/gemini-QQ/bridge/persona.md
!/gemini-QQ/bridge/config.example.json
!/qq-src/
/qq-src/*
!/qq-src/vendor/
/qq-src/vendor/*
!/qq-src/vendor/dsh-fish/
**/node_modules/
**/.env
**/.env.*
**/*.log

# Public social worker sources only; all local profiles, configs and ledgers remain ignored.
!/social/
/social/*
!/social/*.mjs
!/social/*.html
!/social/config.example.json
!/social/README.md
!/docs/social.md

# Explicit protection for social account state and local backups.
**/social.config.json
**/social-data/
/.social-shared/
/.social-backups/
